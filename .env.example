# Yerel geliştirme örneği. Gerçek anahtarları buraya yazma.
DATABASE_URL="postgresql://katman:katman@localhost:5433/katman?schema=public"
AUTH_SECRET="generate-a-random-string"
AUTH_URL="http://localhost:3000"

# Boş bırakılırsa Google ile giriş kapalı kalır.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Boş bırakılırsa Apple ile giriş kapalı kalır.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# true iken checkout kart istemeden simülasyon ödemesi alır.
PAYMENT_SIMULATION="true"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"

# Canlı tahsilat yok. Anahtarlar dolu olsa da bu aşamada kart çekilmez.
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
